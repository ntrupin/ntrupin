<div class="blog-list" role="list">
  {% for update in updates %}
  <article class="blog-row" role="listitem">
    <div class="blog-row-main">
      <p class="blog-date update-date">{{ format_date(update.date, short=True) }}</p>
      <div class="blog-main-text">
        <p lang="en" class="blog-title">{{ update.description | trim }}</p>
      </div>
    </div>
  </article>
  {% else %}
  <p class="muted">{{ _("No updates yet.") }}</p>
  {% endfor %}
</div>
{% if base_endpoint(request.endpoint) != "updates" %}
<p class="blog-more"><a href="{{ url_for('updates') }}">{{ _("All updates \u2192") }}</a></p>
{% endif %}

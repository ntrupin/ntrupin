{% extends "base.jinja" %}
{% from "writing/form.jinja" import form_for with context %}
{% block content %}
<section class="container page">
  <header class="page-head">
    <p class="eyebrow">{{ _("Writing") }}</p>
    <h1 class="page-title">{{ _("New essay") }}</h1>
    <p class="page-subtitle">{{ _("Markdown with automatic sidenotes and equations.") }}</p>
  </header>
  {{ form_for(request.form, available_groups, selected_group_ids, show_group_selector) }}
</section>
{% endblock %}
